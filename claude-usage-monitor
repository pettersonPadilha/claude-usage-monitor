#!/usr/bin/env python3
"""Entry point for the Claude usage monitor."""

import os
import sys
from pathlib import Path

# Force the X11 backend: GTK3 can only keep a window above others under X11
# (or XWayland), which is the whole point of this widget.
os.environ.setdefault("GDK_BACKEND", "x11")

sys.path.insert(0, str(Path(__file__).resolve().parent))

from claude_usage.app import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
